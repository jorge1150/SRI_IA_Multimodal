# .env.example — copiar a .env (NO versionar .env con datos reales)
# Usado por docker-compose.yml en la VM de demo.

# Credenciales para los expertos tributarios durante la ventana de
# validación humana (ver docs/adr/0014). Formato: "user1:pass1,user2:pass2".
# Vacío = sin auth (comportamiento local normal).
GRADIO_AUTH_PAIRS=

# Pipeline agéntico (PlannerAgent + Refiner/Validator, ver ADR-0005/0006).
# Default false en config.py — la demo con expertos probablemente SÍ lo
# quiere prendido, ya que es el argumento central de "por qué es agéntico".
USE_AGENTIC_PLANNER=true
